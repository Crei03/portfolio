---
import Decor from "./Decor.astro";

// Icon paths are thin line drawings (24x24, stroke only).
const CONTACTS = [
  {
    label: "Email",
    value: "carlosreina2100@gmail.com",
    href: "mailto:carlosreina2100@gmail.com",
    icon: ['<rect x="3" y="5" width="18" height="14" rx="2"/>', '<path d="m3 7 9 6 9-6"/>'],
  },
  {
    label: "GitHub",
    value: "github.com/crei03",
    href: "https://github.com/crei03",
    icon: [
      '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>',
      '<path d="M9 18c-4.51 2-5-2-7-2"/>',
    ],
  },
  {
    label: "Instagram",
    value: "@crei03",
    href: "https://instagram.com/crei03",
    icon: ['<rect x="3" y="3" width="18" height="18" rx="5"/>', '<circle cx="12" cy="12" r="4"/>', '<path d="M17.5 6.5h.01"/>'],
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/crei03",
    href: "https://www.linkedin.com/in/crei03",
    icon: [
      '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>',
      '<rect x="2" y="9" width="4" height="12"/>',
      '<circle cx="4" cy="4" r="2"/>',
    ],
  },
  {
    label: "Currículum",
    value: "Descargar CV",
    href: "/Carlos_Reina_CV.pdf",
    download: "Carlos_Reina_CV.pdf",
    icon: ['<path d="M12 3v12"/>', '<path d="m7 10 5 5 5-5"/>', '<path d="M5 21h14"/>'],
  },
];
---

<section id="contacto" class="reveal relative isolate mx-auto max-w-6xl px-4 py-20 md:px-8">
  <span class="kanji-deco right-4 top-16 md:right-8" lang="ja" aria-hidden="true">連絡</span>
  <div class="mb-8">
    <p class="eyebrow">Hablemos</p>
    <h2 class="section-title mt-2 text-3xl md:text-4xl">Contacto</h2>
  </div>

  <p class="max-w-xl text-lg text-sumi-soft">
    ¿Tienes una idea interesante? ¡Trabajemos juntos! Contáctame a través de cualquiera de estos medios.
  </p>

  <div class="relative isolate mt-12 max-w-3xl">
    <Decor variant="blob" tone="ochre" class="absolute -right-10 -top-16 -z-10 w-72 md:-right-40 md:w-96" />
    <ul class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {
        CONTACTS.map(({ label, value, href, icon, download }) => {
          const external = href.startsWith("http");
          return (
            <li>
              <a
                href={href}
                download={download}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="contact-link"
              >
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={icon.join("")} />
                <span>
                  <span class="block text-xs uppercase tracking-[0.25em] text-muted">{label}</span>
                  <span class="ink-link">{value}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .contact-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
  }
  .contact-link svg {
    flex-shrink: 0;
    fill: none;
    stroke: var(--vermilion-dark);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-link:hover .ink-link {
    color: var(--vermilion-dark);
    text-decoration-color: currentColor;
  }
</style>
