---
const GROUPS = [
  {
    title: "Desarrollo",
    items: [
      "Python, Java, PHP",
      "JavaScript / TypeScript",
      "React, Next.js, Node.js",
      "MySQL, PostgreSQL",
      "Microsoft SQL Server, SQLite",
    ],
  },
  {
    title: "QA / Testing",
    items: [
      "Corrección de errores en sistemas legacy",
      "Estabilidad de plataformas",
      "Scrum: sprints, planificación y retrospectivas",
    ],
  },
  {
    title: "Integraciones",
    items: [
      "SAP B1",
      "Pipelines CI/CD",
      "Automatización de despliegues",
      "Transferencia de archivos entre repositorios",
    ],
  },
  {
    title: "Auditoría",
    items: [
      "Revisión de código",
      "Revisión de procesos",
      "Revisión de documentación",
    ],
  },
];

const SOFT_SKILLS = ["Liderazgo de equipos", "Comunicación asertiva", "Negociación técnica", "Resolución de problemas"];
---

<section id="habilidades" class="reveal mx-auto max-w-6xl px-4 py-20 md:px-8">
  <div class="mb-8">
    <p class="eyebrow">Lo que hago</p>
    <h2 class="section-title mt-2 text-3xl md:text-4xl">Habilidades</h2>
  </div>

  <p class="mb-14 max-w-2xl text-lg text-sumi-soft">
    Construyo soluciones web y móviles de punta a punta: desde el levantamiento de requerimientos hasta el despliegue
    automatizado.
  </p>

  <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      GROUPS.map((group) => (
        <div class="reveal-item">
          <h3 class="font-mincho text-lg uppercase tracking-[0.15em]">{group.title}</h3>
          <ul class="mt-4 space-y-2 text-sumi-soft">
            {group.items.map((item) => (
              <li class="skill">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="reveal-item mt-14 border-t border-sand pt-8">
    <h3 class="eyebrow">Habilidades blandas</h3>
    <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sumi-soft">
      {SOFT_SKILLS.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
  </div>
</section>

<style>
  .skill {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .skill::before {
    content: "";
    flex-shrink: 0;
    width: 12px;
    height: 1px;
    background: var(--sand);
  }
</style>
