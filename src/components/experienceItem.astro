---
interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
---

<li class="relative pb-14 pl-10 last:pb-0">
  <span class="timeline-dot" aria-hidden="true"></span>
  <time class="eyebrow">{date}</time>
  <h3 class="mt-2 font-mincho text-xl">{title}</h3>
  <p class="font-medium text-sumi-soft">{company}</p>
  <p class="mt-3 text-sumi-soft">{description}</p>
  {
    link && (
      <a href={link} target="_blank" rel="noopener noreferrer" class="ink-link mt-3 inline-flex items-center gap-1">
        Saber más
        <span class="sr-only">sobre {title} en {company}</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="m9 6 6 6-6 6" />
        </svg>
      </a>
    )
  }
</li>

<style>
  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: var(--vermilion);
    border: 4px solid var(--paper);
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
