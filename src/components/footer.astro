---
import Decor from "./Decor.astro";
import Enso from "./Enso.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-4 pb-10 pt-6 md:px-8">
  <Decor variant="stroke" class="mx-auto w-2/3 max-w-md" />
  <div class="mt-10 flex flex-col items-center justify-between gap-6 text-sm text-muted sm:flex-row">
    <div class="flex items-center gap-3">
      <Enso size={48} />
      <span>
        © {currentYear}
        <a href="https://creina.software/" class="ink-link">Carlos Reina</a>. Casi todos los derechos reservados
      </span>
    </div>
    <ul class="flex gap-6">
      <li><a href="#sobre-mi" class="ink-link">Sobre mí</a></li>
      <li><a href="#contacto" class="ink-link">Contacto</a></li>
    </ul>
  </div>
</footer>
