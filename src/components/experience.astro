---
import ExperienceItem from "./experienceItem.astro";
const EXPERIENCE = [
  {
    date: "Abril 2025",
    title: "Full-Stack Developer",
    company: "Universidad Tecnológica de Panamá",
    description:
      "Contribuí como desarrollador y gestor de la plataforma de registro y asistencia del evento, en la que incluimos un escáner QR para el registro de los participantes.",
    link: "https://www.linkedin.com/posts/crei03_el-pasado-lunes-21-de-abril-la-facultad-activity-7321244449328541698-gjX0?utm_source=share&utm_medium=member_desktop&rcm=ACoAAEbQ36kBmTWBZlgE1tLJ9DiPIYMxl9cBp64",
  },
  {
    date: "Octubre 2024",
    title: "Full-Stack Developer",
    company: "Pycon Panama",
    description:
      "Desarrollé un software para el registro y control de asistencia de los participantes del evento.",
    link: "https://www.linkedin.com/posts/crei03_python-panama-pyconpanama2024-activity-7253103434160033814-OD6r?utm_source=share&utm_medium=member_desktop",
  },
  {
    date: "Septiembre 2024",
    title: "Full-Stack Developer",
    company: "Universidad Tecnológica de Panamá",
    description:
      "Contribuí como desarrollador y gestor de la plataforma de registro y asistencia de la Semana de la Ingeniería.",
    link: "https://www.linkedin.com/posts/crei03_innovation-engineering-softwaredevelopment-activity-7246534286399410176-v4QT?utm_source=share&utm_medium=member_desktop",
  },
  // {
  //   date: "Junio 2024",
  //   title: "ICCA HACKATHON",
  //   company: "FIEXPO, IEEE",
  //   description:
  //     "Participé en el primer hackathon de la ICCA, donde desarrollé una aplicación para la gestión de eventos en tiempo real. Ganamos el tercer lugar.",
  //   link: "https://www.linkedin.com/posts/crei03_iccahackathon-innovacion-tecnologia-activity-7209887821006852096-lk8K?utm_source=share&utm_medium=member_desktop",
  // },
];
---

<section id="experiencia" class="reveal relative mx-auto max-w-6xl px-4 py-20 md:px-8">
  <div class="mb-12 flex items-start gap-4">
    <span class="v-kanji" lang="ja" aria-hidden="true">設計</span>
    <div>
      <p class="eyebrow">Trayectoria</p>
      <h2 class="section-title mt-2 text-3xl md:text-4xl">Experiencia</h2>
    </div>
  </div>

  <div class="relative max-w-3xl">
    <!-- Ink stroke timeline line -->
    <svg
      class="absolute left-[3px] top-2 h-[calc(100%-1rem)] w-3"
      viewBox="0 0 12 400"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M6 0C4 90 8 180 5.5 270S7 360 6 400"
        fill="none"
        stroke-width="2.5"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
        opacity=".45"
        style="stroke: var(--sumi)"></path>
    </svg>
    <ol class="relative">
      {EXPERIENCE.map((experience) => <ExperienceItem {...experience} />)}
    </ol>
  </div>
</section>
