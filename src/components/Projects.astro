---
import projects from "../data/proyectos.json";

// Intrinsic sizes of the images in public/ so the browser can reserve space.
const IMAGE_SIZES: Record<string, [number, number]> = {
  "/Form.jpg": [916, 682],
  "/Scanner.png": [958, 916],
  "/Rpi4.webp": [3060, 3011],
  "/FormAntro.png": [2538, 1406],
};

const linkLabel = (url: string) =>
  url.includes("github.com") ? "GitHub" : url.includes("linkedin.com") ? "Publicación" : "Demo";
---

<section id="proyectos" class="reveal mx-auto max-w-6xl px-4 py-20 md:px-8">
  <div class="mb-12">
    <p class="eyebrow">Trabajos seleccionados</p>
    <h2 class="section-title mt-2 text-3xl md:text-4xl">Proyectos</h2>
  </div>

  <div role="region" aria-roledescription="carousel" aria-label="Proyectos destacados" data-carousel>
    <div class="track" data-track>
      {
        projects.map((project, i) => {
          const [width, height] = IMAGE_SIZES[project.imageUrl] ?? [1200, 800];
          return (
            <div class="slide reveal-item" role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${projects.length}`}>
              <article class="card">
                <img
                  src={project.imageUrl}
                  alt={`Vista previa de ${project.titulo}`}
                  width={width}
                  height={height}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover object-top"
                />
                <div class="flex flex-1 flex-col gap-4 p-6">
                  <h3 class="font-mincho text-xl leading-snug">{project.titulo}</h3>
                  <p class="text-sumi-soft">{project.descripcion}</p>
                  <ul class="flex flex-wrap gap-2" aria-label="Tecnologías">
                    {project.tecnologias.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                  <a
                    href={project.projectUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ink-link mt-auto inline-flex items-center gap-2 self-start"
                  >
                    {linkLabel(project.projectUrl)}
                    <span class="sr-only">de {project.titulo}</span>
                    <svg class="line-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </a>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>

    <div class="mt-8 flex items-center justify-between gap-4">
      <button type="button" class="nav-btn" aria-label="Proyecto anterior" data-prev>
        <svg class="line-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m15 6-6 6 6 6"></path>
        </svg>
      </button>
      <div class="flex gap-1">
        {
          projects.map((project, i) => (
            <button type="button" class="dot" aria-label={`Ir al proyecto ${i + 1}: ${project.titulo}`} data-dot />
          ))
        }
      </div>
      <button type="button" class="nav-btn" aria-label="Proyecto siguiente" data-next>
        <svg class="line-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const behavior = (): ScrollBehavior =>
      matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
    const step = () => slides[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap || "0");
    const scrollToSlide = (i: number) => track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: behavior() });

    carousel.querySelector("[data-prev]")?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: behavior() }));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: behavior() }));
    dots.forEach((dot, i) => dot.addEventListener("click", () => scrollToSlide(i)));

    // A dot is active while its slide is mostly visible (1–3 slides depending on width).
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const dot = dots[slides.indexOf(entry.target as HTMLElement)];
          dot?.setAttribute("aria-current", String(entry.isIntersecting));
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((slide) => observer.observe(slide));
  });
</script>

<style>
  .track {
    position: relative;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    padding-block: 8px;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    display: flex;
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .slide {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .slide {
      flex-basis: calc((100% - 3rem) / 3);
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--sand);
    border-radius: 0.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    border-color: var(--vermilion);
  }
  .card img {
    border-bottom: 1px solid var(--sand);
  }
  .tag {
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    color: var(--sumi-soft);
    border: 1px solid var(--sand);
    border-radius: 9999px;
  }
  .line-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--sand);
    border-radius: 9999px;
    color: var(--vermilion-dark);
    transition: border-color 0.2s ease;
  }
  .nav-btn:hover {
    border-color: var(--vermilion);
  }
  .dot {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
  }
  .dot::before {
    content: "";
    width: 10px;
    height: 10px;
    border: 1px solid var(--sand);
    border-radius: 9999px;
    transition: background-color 0.2s ease;
  }
  .dot[aria-current="true"]::before {
    background: var(--vermilion);
    border-color: var(--vermilion);
  }
</style>
